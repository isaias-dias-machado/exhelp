#!/bin/sh
#
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: Isaías Dias Machado

exh={{EXECUTABLE}}
tags=$HOME/.cache/exh/tags

call_fzf() {
		if [ ! -f "${tags}" ]; then
			echo "No tags file. Run 'exh fetch'"
			exit 0
		fi

		selected="$(cat "${tags}" | fzf)"
		if [ -n "$selected" ]; then
			if [ -n "$PAGER" ]; then
					"${exh}" $selected | $PAGER
			else
					"${exh}" $selected | less -R
			fi
		fi
}

case "${1:-}" in
	"")
		call_fzf
		;;

	fetch)
		if [ "$2" = "--prune" ]; then
			mix docs.cache prune
		else
			mix docs.cache
		fi
		;;

	clear)
		"${exh}" --clear
		;;

	*)
		"${exh}" --help
		;;
esac

